      </sc:Property>
      <sc:Property>
       <sc:name>originalDatavert</sc:name>
       <sc:id>C3_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>ansvarlig etat for forvaltning av data</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
