     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>områdeId</sc:name>
       <sc:id>C3_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>identifikasjon av område som dataene dekker

