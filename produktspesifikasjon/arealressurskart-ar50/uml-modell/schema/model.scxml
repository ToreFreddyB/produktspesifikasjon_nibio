           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>kopidata</sc:name>
         <sc:id>C1_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>angivelse av at objektet er hentet fra en kopi av originaldata
Merknad:
Kan benyttes dersom man gjør et uttak av en database som ikke inneholder originaldataene.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
