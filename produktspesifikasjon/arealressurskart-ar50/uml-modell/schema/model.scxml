       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekt som bærer en rekke egenskaper som er fagområde-uavhengige og kan benyttes for alle objekttyper

Merknad:
Spesielt i produktspesifikasjonsarbeid vil en velge egenskaper og av grensningslinjer fra denne klassen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:properties>
        <sc:Property>
         <sc:name>identifikasjon</sc:name>
         <sc:id>C1_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>unik identifikasjon av et objekt</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C4</sc:typeId>
         <sc:typeName>Identifikasjon</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>informasjon</sc:name>
         <sc:id>C1_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
